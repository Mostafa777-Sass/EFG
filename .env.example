# --- Database -----------------------------------------------------------------
# SQLite file. Relative paths are resolved from the prisma/ folder.
# Docker uses file:/data/egf.db (set in docker-compose.yml).
DATABASE_URL="file:./dev.db"

# --- Uploads ------------------------------------------------------------------
# Where admin image uploads are stored. Docker uses /data/uploads.
UPLOAD_DIR="./data/uploads"

# --- Site ---------------------------------------------------------------------
# Public URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Initial admin account (used only by the seed when no admin exists) --------
ADMIN_EMAIL="admin@egyptgasfittings.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="EGF Administrator"

# --- Email notifications for new inquiries (optional) --------------------------
# Leave SMTP_HOST empty to disable. Inquiries are always stored in the admin panel.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EGF Website <no-reply@egyptgasfittings.com>"
INQUIRY_NOTIFY_TO="info@egyptgasfittings.com"

# --- Cookies ------------------------------------------------------------------
# Set to "false" only if the site is served over plain HTTP (not recommended).
COOKIE_SECURE="true"

# --- Server bind address (production without Docker) ---------------------------
# PORT="3000"
# HOSTNAME="127.0.0.1"
